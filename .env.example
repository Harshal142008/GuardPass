# Optional Supabase configuration for authenticated sync.
# The local demo runs without these values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local demo admin gate. Keep the real password in .env.local or your hosting secret store.
VITE_ADMIN_EMAIL=admin123@gmail.com
VITE_ADMIN_PASSWORD=change-this-admin-password
